---
import { Image } from 'astro:assets';
import LanguageRibbon from './LanguageRibbon.astro';
import { PILLARS, t, type Lang } from '@i18n/ui';
import {
  postPath,
  readingTimeMinutes,
  formatDate,
  type Post,
} from '@lib/posts';

interface Props {
  post: Post;
  lang: Lang;
  featured?: boolean;
  /** Optional eager loading for above-the-fold cards. */
  eager?: boolean;
}

const { post, lang, featured = false, eager = false } = Astro.props;
const tr = t(lang);
const { data } = post;
const pillar = PILLARS[data.pillar];
const minutes = readingTimeMinutes(post.body);
const href = postPath(post);
---

<article class:list={['card', { 'card--featured': featured }]}>
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    {
      data.heroImage ? (
        <Image
          src={data.heroImage}
          alt={data.heroAlt}
          widths={featured ? [480, 800, 1200] : [320, 480, 720]}
          sizes={
            featured
              ? '(max-width: 860px) 100vw, 60vw'
              : '(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 360px'
          }
          loading={eager ? 'eager' : 'lazy'}
          class="card__img"
        />
      ) : (
        <span class="card__placeholder" />
      )
    }
    <LanguageRibbon language={data.language} size="sm" class="card__ribbon" />
  </a>

  <div class="card__body">
    <div class="card__meta">
      <a class="card__pillar" href={`${lang === 'en' ? '/en' : ''}${pillar.href}`}>
        {pillar.label[lang]}
      </a>
      <span class="card__dot" aria-hidden="true">·</span>
      <span class="card__rt">{minutes} {tr('post.readingTime')}</span>
    </div>

    <h3 class="card__title">
      <a href={href}>{data.title}</a>
    </h3>

    <p class="card__excerpt">{data.excerpt}</p>

    <div class="card__foot">
      <span class="card__author">{data.author}</span>
      <time datetime={data.pubDate.toISOString()}>
        {formatDate(data.pubDate, lang)}
      </time>
      {data.sample && <span class="card__sample">{tr('post.sample')}</span>}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    height: 100%;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }
  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    background: var(--sand-deep);
    overflow: hidden;
  }
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--teal), var(--ink));
  }
  .card__ribbon {
    position: absolute;
    top: 0.75rem;
    left: 0;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.1rem 1.2rem 1.3rem;
    flex: 1;
  }
  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--ink-55);
  }
  .card__pillar {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--teal);
    text-decoration: none;
  }
  .card__pillar:hover {
    color: var(--coral-deep);
  }
  .card__title {
    margin: 0;
    font-size: 1.32rem;
    line-height: 1.2;
  }
  .card--featured .card__title {
    font-size: clamp(1.7rem, 3.5vw, 2.6rem);
  }
  .card__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .card__title a:hover {
    color: var(--coral-deep);
  }
  .card__excerpt {
    margin: 0;
    color: var(--ink-70);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .card--featured .card__excerpt {
    font-size: 1.1rem;
  }
  .card__foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: 0.82rem;
    color: var(--ink-55);
  }
  .card__author {
    font-weight: 650;
    color: var(--ink-70);
  }
  .card__foot time::before {
    content: '· ';
  }
  .card__sample {
    margin-left: auto;
    background: var(--gold);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
  }

  /* Featured: horizontal split on wide screens */
  @media (min-width: 860px) {
    .card--featured {
      flex-direction: row;
      align-items: stretch;
    }
    .card--featured .card__media {
      flex: 1 1 56%;
      aspect-ratio: auto;
    }
    .card--featured .card__body {
      flex: 1 1 44%;
      justify-content: center;
      padding: 2.2rem 2.4rem;
      gap: 0.8rem;
    }
  }
</style>
