---
/** Pull quote — a visual signature of the publication, in Deep Teal.
 *  Usable inside MDX or any layout. */
interface Props {
  cite?: string;
}
const { cite } = Astro.props;
---

<figure class="pullquote">
  <span class="pullquote__mark" aria-hidden="true">&ldquo;</span>
  <blockquote>
    <slot />
  </blockquote>
  {cite && <figcaption>— {cite}</figcaption>}
</figure>

<style>
  .pullquote {
    margin: 2.5rem 0;
    padding: 0;
    position: relative;
    max-width: var(--measure);
  }
  .pullquote__mark {
    position: absolute;
    top: -1.6rem;
    left: -0.4rem;
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 1;
    color: var(--gold);
    opacity: 0.5;
  }
  .pullquote blockquote {
    margin: 0;
    padding-left: 1.4rem;
    border-left: 4px solid var(--teal);
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    line-height: 1.3;
    color: var(--teal);
  }
  .pullquote figcaption {
    margin-top: 0.9rem;
    padding-left: 1.4rem;
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 650;
    font-size: 0.92rem;
    color: var(--ink-70);
  }
</style>
