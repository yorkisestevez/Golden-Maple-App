---
/** Social share — WhatsApp first (this is the DR). Then Facebook, X, copy. */
import { t, type Lang } from '@i18n/ui';

interface Props {
  url: string; // absolute URL
  title: string;
  lang: Lang;
}
const { url, title, lang } = Astro.props;
const tr = t(lang);

const enc = encodeURIComponent;
const waText = `${title} — ${url}`;
const whatsapp = `https://wa.me/?text=${enc(waText)}`;
const facebook = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
const x = `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(url)}`;
---

<div class="share" data-share data-url={url} data-title={title}>
  <span class="share__label">{tr('post.share')}</span>

  <a
    class="share__btn share__btn--wa"
    href={whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={tr('post.shareWhatsApp')}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.8c2.16 0 4.19.84 5.72 2.37a8.07 8.07 0 0 1 2.37 5.74c0 4.47-3.64 8.11-8.11 8.11h-.01a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.12.82.83-3.04-.19-.31a8.06 8.06 0 0 1-1.24-4.32c0-4.47 3.64-8.11 8.18-8.11Zm-2.42 4.32c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2 0 1.18.86 2.32.98 2.48.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.5.57.18 1.1.16 1.51.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.93-1.19-.71-.64-1.19-1.42-1.33-1.66-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46Z"/>
    </svg>
    <span>WhatsApp</span>
  </a>

  <a
    class="share__btn"
    href={facebook}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={tr('post.shareFacebook')}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M22 12.07C22 6.5 17.52 2 12 2S2 6.5 2 12.07c0 5 3.66 9.15 8.44 9.93v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.44 2.9h-2.34V22c4.78-.78 8.43-4.93 8.43-9.93Z"/>
    </svg>
    <span class="visually-hidden">Facebook</span>
  </a>

  <a
    class="share__btn"
    href={x}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={tr('post.shareX')}
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.81-5.96 6.81H1.69l7.73-8.84L1.27 2.25h6.82l4.71 6.23 5.44-6.23Zm-1.16 17.52h1.83L7.01 4.13H5.04l12.04 15.64Z"/>
    </svg>
    <span class="visually-hidden">X</span>
  </a>

  <button class="share__btn share__copy" type="button" data-copy aria-label={tr('post.shareCopy')}>
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
      <path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/>
      <path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/>
    </svg>
    <span class="share__copy-label" data-done={tr('post.shareCopied')}>{tr('post.shareCopy')}</span>
  </button>
</div>

<script>
  document.querySelectorAll('[data-share]').forEach((el) => {
    const btn = el.querySelector('[data-copy]');
    const label = btn?.querySelector('.share__copy-label');
    const url = (el as HTMLElement).dataset.url || location.href;
    const original = label?.textContent || '';
    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        el.classList.add('is-copied');
        if (label) label.textContent = label.getAttribute('data-done') || '✓';
        setTimeout(() => {
          el.classList.remove('is-copied');
          if (label) label.textContent = original;
        }, 1800);
      } catch {
        /* clipboard unavailable — no-op */
      }
    });
  });
</script>

<style>
  .share {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .share__label {
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-55);
    margin-right: 0.25rem;
  }
  .share__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1.5px solid var(--ink-12);
    background: var(--white);
    color: var(--ink);
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 650;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .share__btn:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .share__btn--wa {
    background: #25d366;
    border-color: #25d366;
    color: #fff;
  }
  .share__btn--wa:hover {
    background: #1eb858;
    border-color: #1eb858;
    color: #fff;
  }
  .is-copied .share__copy {
    border-color: var(--teal);
    color: var(--teal);
  }
</style>
