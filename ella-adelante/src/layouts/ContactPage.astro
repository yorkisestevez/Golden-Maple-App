---
import BaseLayout from './BaseLayout.astro';
import { SOCIAL, t, type Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<BaseLayout
  title={tr('contact.title')}
  description={tr('contact.intro')}
  lang={lang}
  alternates={[
    { lang: 'es', href: '/contacto' },
    { lang: 'en', href: '/en/contacto' },
  ]}
>
  <section class="contact wrap">
    <div class="contact__intro">
      <p class="eyebrow">{tr('nav.contact')}</p>
      <h1>{tr('contact.title')}</h1>
      <p class="contact__lead">{tr('contact.intro')}</p>
      <p class="contact__pitch-hint">{tr('contact.pitchHint')}</p>
      <p class="contact__direct">
        <a href={`mailto:${SOCIAL.email}`}>{SOCIAL.email}</a>
        <span aria-hidden="true">·</span>
        <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer">
          {SOCIAL.instagramHandle}
        </a>
      </p>
    </div>

    <!--
      Netlify Forms: the data-netlify attribute wires submissions to the
      Netlify dashboard with no backend. The honeypot blocks spam bots.
    -->
    <form
      class="contact__form"
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-success={tr('contact.success')}
      action={`${lang === 'en' ? '/en' : ''}/contacto?ok=1`}
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden-field">
        <label>
          {lang === 'en' ? "Don't fill this out:" : 'No llenes esto:'}
          <input name="bot-field" />
        </label>
      </p>

      <div class="field-row">
        <div class="field">
          <label for="c-name">{tr('contact.name')}</label>
          <input id="c-name" type="text" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="c-email">{tr('contact.email')}</label>
          <input id="c-email" type="email" name="email" autocomplete="email" required />
        </div>
      </div>

      <div class="field">
        <label for="c-type">{tr('contact.type')}</label>
        <select id="c-type" name="type">
          <option value="pitch">{tr('contact.type.pitch')}</option>
          <option value="collab">{tr('contact.type.collab')}</option>
          <option value="other">{tr('contact.type.other')}</option>
        </select>
      </div>

      <div class="field">
        <label for="c-message">{tr('contact.message')}</label>
        <textarea id="c-message" name="message" rows="6" required></textarea>
      </div>

      <button class="btn btn-primary" type="submit">{tr('contact.send')}</button>
    </form>
  </section>
</BaseLayout>

<script is:inline>
  // Friendly inline confirmation after Netlify's redirect (?ok=1).
  if (new URLSearchParams(location.search).get('ok') === '1') {
    const form = document.querySelector('.contact__form');
    if (form) {
      const note = document.createElement('p');
      note.className = 'contact__success';
      note.setAttribute('role', 'status');
      note.textContent = form.getAttribute('data-success') || '';
      form.replaceWith(note);
    }
  }
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding: 3.5rem 0 2rem;
    align-items: start;
  }
  .contact__lead {
    font-size: 1.15rem;
    color: var(--ink-70);
  }
  .contact__pitch-hint {
    background: var(--sand-deep);
    border-left: 3px solid var(--gold);
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    font-size: 0.95rem;
    color: var(--ink-70);
  }
  .contact__direct {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-weight: 600;
    margin-top: 1.4rem;
  }
  .contact__form {
    background: var(--white);
    padding: 1.8rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    display: grid;
    gap: 1.1rem;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .hidden-field {
    display: none;
  }
  .contact__success {
    background: var(--teal);
    color: var(--sand);
    padding: 1.5rem 1.8rem;
    border-radius: var(--radius-lg);
    font-size: 1.1rem;
    font-weight: 600;
  }
  @media (max-width: 780px) {
    .contact {
      grid-template-columns: 1fr;
    }
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
