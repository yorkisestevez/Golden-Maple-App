---
import BaseLayout from './BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import Newsletter from '@components/Newsletter.astro';
import LanguageRibbon from '@components/LanguageRibbon.astro';
import { Image } from 'astro:assets';
import {
  PILLARS,
  SITE_NAME,
  TAGLINE,
  t,
  type Lang,
  type PillarKey,
} from '@i18n/ui';
import {
  getFeaturedPost,
  getPostsByLang,
  getPostsByPillar,
  postPath,
  readingTimeMinutes,
  formatDate,
} from '@lib/posts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const base = lang === 'en' ? '/en' : '';

const featured = await getFeaturedPost(lang);
const all = await getPostsByLang(lang);
const latest = all.filter((p) => p.id !== featured?.id).slice(0, 4);

// Build a small strip per pillar (skip empty ones).
const pillarKeys = Object.keys(PILLARS) as PillarKey[];
const pillarStrips = await Promise.all(
  pillarKeys.map(async (key) => ({
    key,
    info: PILLARS[key],
    posts: (await getPostsByPillar(key, lang))
      .filter((p) => p.id !== featured?.id)
      .slice(0, 3),
  })),
);

const featMinutes = featured ? readingTimeMinutes(featured.body) : 0;
---

<BaseLayout
  title={SITE_NAME}
  description={TAGLINE[lang]}
  lang={lang}
  alternates={[
    { lang: 'es', href: '/' },
    { lang: 'en', href: '/en' },
  ]}
>
  <section class="intro wrap">
    <p class="intro__tag">{TAGLINE[lang]}</p>
  </section>

  {
    featured && (
      <section class="hero wrap" aria-label={tr('home.featured')}>
        <a class="hero__media" href={postPath(featured)} tabindex="-1" aria-hidden="true">
          {featured.data.heroImage ? (
            <Image
              src={featured.data.heroImage}
              alt={featured.data.heroAlt}
              widths={[600, 900, 1300]}
              sizes="(max-width: 900px) 100vw, 60vw"
              loading="eager"
              fetchpriority="high"
              class="hero__img"
            />
          ) : (
            <span class="hero__placeholder" />
          )}
          <LanguageRibbon language={featured.data.language} class="hero__ribbon" />
        </a>
        <div class="hero__body">
          <p class="eyebrow">{tr('home.featured')}</p>
          <p class="hero__pillar">{PILLARS[featured.data.pillar].label[lang]}</p>
          <h1 class="hero__title">
            <a href={postPath(featured)}>{featured.data.title}</a>
          </h1>
          <p class="hero__excerpt">{featured.data.excerpt}</p>
          <div class="hero__meta">
            <span>{featured.data.author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={featured.data.pubDate.toISOString()}>
              {formatDate(featured.data.pubDate, lang)}
            </time>
            <span aria-hidden="true">·</span>
            <span>{featMinutes} {tr('post.readingTime')}</span>
          </div>
          <a class="btn btn-primary hero__cta" href={postPath(featured)}>
            {tr('home.readStory')}
          </a>
        </div>
      </section>
    )
  }

  {
    latest.length > 0 && (
      <section class="wrap latest" aria-labelledby="latest-title">
        <div class="section-head">
          <h2 id="latest-title">{tr('home.latest')}</h2>
          <span class="gold-rule" aria-hidden="true" />
        </div>
        <div class="latest__grid">
          {latest.map((p) => (
            <PostCard post={p} lang={lang} />
          ))}
        </div>
      </section>
    )
  }

  <Newsletter lang={lang} />

  {
    pillarStrips
      .filter((s) => s.posts.length > 0)
      .map((strip) => (
        <section class="wrap strip" aria-labelledby={`strip-${strip.key}`}>
          <div class="section-head">
            <div>
              <h2 id={`strip-${strip.key}`}>{strip.info.label[lang]}</h2>
              <p class="strip__mission">{strip.info.mission[lang]}</p>
            </div>
            <a class="strip__all" href={`${base}${strip.info.href}`}>
              {tr('home.viewAll')} →
            </a>
          </div>
          <div class="strip__grid">
            {strip.posts.map((p) => (
              <PostCard post={p} lang={lang} />
            ))}
          </div>
        </section>
      ))
  }
</BaseLayout>

<style>
  .intro {
    padding: 2.5rem 0 0;
  }
  .intro__tag {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3.2vw, 2rem);
    line-height: 1.3;
    color: var(--teal);
    max-width: 22ch;
    margin: 0;
    font-weight: 500;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    margin: 2rem auto 4rem;
  }
  .hero__media {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--sand-deep);
    box-shadow: var(--shadow);
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--teal), var(--ink));
  }
  .hero__ribbon {
    position: absolute;
    top: 1rem;
    left: 0;
  }
  .hero__pillar {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: var(--coral-deep);
    margin: 0 0 0.4rem;
  }
  .hero__title {
    margin: 0 0 0.8rem;
    font-size: clamp(2rem, 5vw, 3.4rem);
  }
  .hero__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .hero__title a:hover {
    color: var(--coral-deep);
  }
  .hero__excerpt {
    font-size: 1.12rem;
    color: var(--ink-70);
    max-width: 46ch;
  }
  .hero__meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: var(--ink-55);
    margin-bottom: 1.4rem;
  }

  .latest__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--gap);
  }
  .latest {
    margin-top: 1rem;
  }

  .strip {
    margin-top: 4rem;
  }
  .strip__mission {
    margin: 0.2rem 0 0;
    color: var(--ink-55);
    font-size: 0.96rem;
    max-width: 48ch;
  }
  .strip__all {
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    color: var(--teal);
  }
  .strip__all:hover {
    color: var(--coral-deep);
  }
  .strip__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--gap);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
