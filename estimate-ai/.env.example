# ============================================================================
# EstimateAI — Environment variables
# ============================================================================
# Copy this file to .env.local and fill in the values. .env.local is
# gitignored — never commit real secrets.
#
#   cp .env.example .env.local
#
# For production (Netlify), set the same keys in the Netlify dashboard under
# Site settings → Environment variables. NEXT_PUBLIC_* vars are exposed to
# the browser; everything else is server-only.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Supabase — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
# Supabase dashboard: https://supabase.com/dashboard/project/psezdpslixisifzphrhh
# Keys page:          Settings → API → Project API keys
# Used by:            lib/supabase/{server,client,middleware}.ts, all API routes

# Project URL — public, exposed to browser. Pre-filled with EstimateAI's project ref.
NEXT_PUBLIC_SUPABASE_URL=https://psezdpslixisifzphrhh.supabase.co

# Anon (public) key — safe to expose. Required for the public embed form and
# client-side auth flows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SECRET. Bypasses Row Level Security. Server-only.
# Used by: /api/seed, /api/webhook/lead, /api/webhook/stripe, /api/ai-insight,
#          app/embed/[slug]/page.tsx (createServiceClient).
# NEVER commit, NEVER expose to browser, NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Stripe — REQUIRED for billing / checkout / subscription management
# ─────────────────────────────────────────────────────────────────────────────
# Dashboard:    https://dashboard.stripe.com/
# API keys:     Developers → API keys (use test mode during development)
# Webhooks:     Developers → Webhooks → add endpoint for /api/webhook/stripe
# Price IDs:    Products → create 3 products (Standard/Pro/Agency), copy price IDs
# Used by:      lib/stripe.ts, /api/billing/checkout, /api/billing/portal,
#               /api/webhook/stripe

# Secret API key. Use sk_test_... during development, sk_live_... in production.
STRIPE_SECRET_KEY=

# Webhook signing secret. Copy from the Stripe dashboard after creating the
# webhook endpoint. Different for local CLI testing vs deployed endpoint.
STRIPE_WEBHOOK_SECRET=

# Price IDs for each plan (price_XXXXXXXXXXXXXXXXXXXXXXXX format).
# Create 3 recurring products in Stripe matching the pricing shown on /pricing:
#   Standard: $97/month
#   Pro:      $197/month
#   Agency:   $497/month
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=


# ─────────────────────────────────────────────────────────────────────────────
# Resend — REQUIRED for lead notification emails
# ─────────────────────────────────────────────────────────────────────────────
# Dashboard:  https://resend.com/
# API keys:   Dashboard → API Keys → create
# Domains:    Verify a sending domain before sending to real addresses
# Used by:    lib/resend.ts, /api/webhook/lead (sends lead notifications to
#             contractor.notification_email when a homeowner submits an estimate)

RESEND_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Anthropic — REQUIRED for AI design insights (Pro / Agency tiers only)
# ─────────────────────────────────────────────────────────────────────────────
# Console:    https://console.anthropic.com/
# API keys:   Settings → API keys
# Used by:    /api/ai-insight (generates personalized design tips per estimate)

ANTHROPIC_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Instagram — "DYG123" assistant (receive + reply to DMs and comments)
# ─────────────────────────────────────────────────────────────────────────────
# Meta dashboard: https://developers.facebook.com/apps/  (create an app, add the
#                 "Instagram" product, enable Instagram messaging + webhooks)
# Requires:       an Instagram Professional (Business/Creator) account linked to
#                 a Facebook Page.
# Used by:        lib/instagram.ts, lib/ig-assistant.ts, /api/webhook/instagram
# Full setup:     docs/INSTAGRAM-DYG123-SETUP.md

# Meta app secret — verifies that incoming webhooks really came from Meta
# (X-Hub-Signature-256). Found at App settings → Basic → App Secret. SECRET.
IG_APP_SECRET=

# A string YOU choose. Enter the same value here and in the Meta webhook
# config; Meta echoes it back during the subscription handshake.
IG_VERIFY_TOKEN=

# Long-lived Instagram/Page access token used to send replies. SECRET.
IG_ACCESS_TOKEN=

# Optional — Graph API version (defaults to v21.0).
IG_GRAPH_API_VERSION=

# Optional — assistant + business identity used in the AI's tone/persona.
IG_ASSISTANT_NAME=DYG123
IG_BUSINESS_NAME=Golden Maple


# ─────────────────────────────────────────────────────────────────────────────
# App config
# ─────────────────────────────────────────────────────────────────────────────
# The base URL the app advertises to itself. Used for Stripe checkout redirect
# URLs, email links, and the embed script generator. Must be the real public
# URL in production (no trailing slash).
#   Development: http://localhost:3000
#   Production:  https://estimateai.netlify.app  (or custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000
